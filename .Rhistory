mi_prop_test_2vectores_binarios <- function(x1, x2,
alternativa = "bilateral",
conf.level = 0.95,
alphas = NULL,
graficar = TRUE) {
# Validación
if (!all(x1 %in% c(0, 1)) || !all(x2 %in% c(0, 1))) {
stop("Ambos vectores deben ser binarios (0 y 1).")
}
# Conteos y proporciones
n1 <- length(x1)
n2 <- length(x2)
x1_sum <- sum(x1)
x2_sum <- sum(x2)
p1_hat <- x1_sum / n1
p2_hat <- x2_sum / n2
# Proporción combinada (bajo H0)
p_comb <- (x1_sum + x2_sum) / (n1 + n2)
# Error estándar
error_estandar <- sqrt(p_comb * (1 - p_comb) * (1 / n1 + 1 / n2))
# Estadístico Z
z <- (p1_hat - p2_hat) / error_estandar
# Valor-p según tipo de prueba
p_value <- switch(alternativa,
"mayor" = pnorm(z, lower.tail = FALSE),
"menor" = pnorm(z, lower.tail = TRUE),
"bilateral" = 2 * pnorm(-abs(z)),
stop("Alternativa no válida. Use 'mayor', 'menor' o 'bilateral'."))
# Si no se pasan alphas, usar el del conf.level
if (is.null(alphas)) {
alphas <- 1 - conf.level
}
# Evaluar decisiones para todos los alphas
decisiones <- data.frame(
alpha = alphas,
decision = ifelse(p_value < alphas, "Rechazar H0", "No Rechazar H0")
)
# Intervalo de confianza para la diferencia de proporciones
alpha <- 1 - conf.level
z_crit <- qnorm(1 - alpha / 2)
error_indep <- sqrt((p1_hat * (1 - p1_hat)) / n1 + (p2_hat * (1 - p2_hat)) / n2)
IC <- c((p1_hat - p2_hat) - z_crit * error_indep,
(p1_hat - p2_hat) + z_crit * error_indep)
# Gráfico opcional
if (graficar) {
curve(dnorm(x), from = -4, to = 4, lwd = 2, col = "gray30",
ylab = "Densidad", xlab = "Z", main = "Prueba Z para dos proporciones")
abline(v = z, col = "blue", lwd = 2, lty = 2)
legend("topright", legend = paste("Z =", round(z, 3)), col = "blue", lty = 2, bty = "n")
if (alternativa == "bilateral") {
abline(v = c(-z_crit, z_crit), col = "red", lty = 3)
} else if (alternativa == "mayor") {
abline(v = qnorm(1 - alpha), col = "red", lty = 3)
} else if (alternativa == "menor") {
abline(v = qnorm(alpha), col = "red", lty = 3)
}
}
# Resultado
list(
proporcion_1 = p1_hat,
proporcion_2 = p2_hat,
diferencia_observada = p1_hat - p2_hat,
estadistico_z = z,
p_value = p_value,
intervalo_confianza = IC,
decisiones = decisiones
)
}
#Evaluamos
resultado <- mi_prop_test_2vectores_binarios(
edu_mayo,
edu_julio,
alphas = c(0.030, 0.070, 0.025, 0.045, 0.001)
)
resultado$decisiones
mi_prop_test_2vectores_binarios <- function(x1, x2,
alternativa = "bilateral",
conf.level = 0.95,
alphas = NULL,
graficar = TRUE) {
# Validación
if (!all(x1 %in% c(0, 1)) || !all(x2 %in% c(0, 1))) {
stop("Ambos vectores deben ser binarios (0 y 1).")
}
# Conteos y proporciones
n1 <- length(x1)
n2 <- length(x2)
x1_sum <- sum(x1)
x2_sum <- sum(x2)
p1_hat <- x1_sum / n1
p2_hat <- x2_sum / n2
# Proporción combinada (bajo H0)
p_comb <- (x1_sum + x2_sum) / (n1 + n2)
# Error estándar
error_estandar <- sqrt(p_comb * (1 - p_comb) * (1 / n1 + 1 / n2))
# Estadístico Z
z <- (p1_hat - p2_hat) / error_estandar
# Valor-p según tipo de prueba
p_value <- switch(alternativa,
"mayor" = pnorm(z, lower.tail = FALSE),
"menor" = pnorm(z, lower.tail = TRUE),
"bilateral" = 2 * pnorm(-abs(z)),
stop("Alternativa no válida. Use 'mayor', 'menor' o 'bilateral'."))
# Si no se pasan alphas, usar el del conf.level
if (is.null(alphas)) {
alphas <- 1 - conf.level
}
# Evaluar decisiones para todos los alphas
decisiones <- data.frame(
alpha = alphas,
decision = ifelse(p_value < alphas, "Rechazar H0", "No Rechazar H0")
)
# Intervalo de confianza para la diferencia de proporciones
alpha <- 1 - conf.level
z_crit <- qnorm(1 - alpha / 2)
error_indep <- sqrt((p1_hat * (1 - p1_hat)) / n1 + (p2_hat * (1 - p2_hat)) / n2)
IC <- c((p1_hat - p2_hat) - z_crit * error_indep,
(p1_hat - p2_hat) + z_crit * error_indep)
# Gráfico opcional
if (graficar) {
curve(dnorm(x), from = -4, to = 4, lwd = 2, col = "gray30",
ylab = "Densidad", xlab = "Z", main = "Prueba Z para dos proporciones")
abline(v = z, col = "blue", lwd = 2, lty = 2)
legend("topright", legend = paste("Z =", round(z, 3)), col = "blue", lty = 2, bty = "n")
if (alternativa == "bilateral") {
abline(v = c(-z_crit, z_crit), col = "red", lty = 3)
} else if (alternativa == "mayor") {
abline(v = qnorm(1 - alpha), col = "red", lty = 3)
} else if (alternativa == "menor") {
abline(v = qnorm(alpha), col = "red", lty = 3)
}
}
# Resultado
list(
proporcion_1 = p1_hat,
proporcion_2 = p2_hat,
diferencia_observada = p1_hat - p2_hat,
estadistico_z = z,
p_value = p_value,
intervalo_confianza = IC,
# decisión clásica (con conf.level)
decision = ifelse(p_value < (1 - conf.level),
"Rechazar H0",
"No Rechazar H0"),
# decisiones múltiples
decisiones = decisiones
)
}
#Evaluamos
resultado <- mi_prop_test_2vectores_binarios(
edu_mayo,
edu_julio,
alphas = c(0.030, 0.070, 0.025, 0.045, 0.001)
)
resultado$decisiones
resultado
mi_prop_test_2vectores_binarios <- function(x1, x2,
alternativa = "bilateral",
alphas = c(0.05),
graficar = TRUE) {
# Validación
if (!all(x1 %in% c(0, 1)) || !all(x2 %in% c(0, 1))) {
stop("Ambos vectores deben ser binarios (0 y 1).")
}
# Conteos y proporciones
n1 <- length(x1)
n2 <- length(x2)
x1_sum <- sum(x1)
x2_sum <- sum(x2)
p1_hat <- x1_sum / n1
p2_hat <- x2_sum / n2
# Proporción combinada (bajo H0)
p_comb <- (x1_sum + x2_sum) / (n1 + n2)
# Error estándar
error_estandar <- sqrt(p_comb * (1 - p_comb) * (1 / n1 + 1 / n2))
# Estadístico Z
z <- (p1_hat - p2_hat) / error_estandar
# Valor-p
p_value <- switch(alternativa,
"mayor" = pnorm(z, lower.tail = FALSE),
"menor" = pnorm(z, lower.tail = TRUE),
"bilateral" = 2 * pnorm(-abs(z)))
# 🔹 Resultados por cada alpha
resultados <- lapply(alphas, function(alpha) {
z_crit <- qnorm(1 - alpha / 2)
error_indep <- sqrt((p1_hat * (1 - p1_hat)) / n1 +
(p2_hat * (1 - p2_hat)) / n2)
IC <- c((p1_hat - p2_hat) - z_crit * error_indep,
(p1_hat - p2_hat) + z_crit * error_indep)
list(
alpha = alpha,
proporcion_1 = p1_hat,
proporcion_2 = p2_hat,
diferencia_observada = p1_hat - p2_hat,
estadistico_z = z,
p_value = p_value,
intervalo_confianza = IC,
decision = ifelse(p_value < alpha, "Rechazar H0", "No Rechazar H0")
)
})
return(resultados)
}
#Evaluamos
resultado <- mi_prop_test_2vectores_binarios(
edu_mayo,
edu_julio,
alphas = c(0.030, 0.070, 0.025, 0.045, 0.001)
)
resultado
mi_prop_test_2vectores_binarios <- function(x1, x2,
alternativa = "bilateral",
alphas = c(0.05),
graficar = TRUE) {
# Validación
if (!all(x1 %in% c(0, 1)) || !all(x2 %in% c(0, 1))) {
stop("Ambos vectores deben ser binarios (0 y 1).")
}
# Conteos y proporciones
n1 <- length(x1)
n2 <- length(x2)
x1_sum <- sum(x1)
x2_sum <- sum(x2)
p1_hat <- x1_sum / n1
p2_hat <- x2_sum / n2
# Proporción combinada (bajo H0)
p_comb <- (x1_sum + x2_sum) / (n1 + n2)
# Error estándar
error_estandar <- sqrt(p_comb * (1 - p_comb) * (1 / n1 + 1 / n2))
# Estadístico Z
z <- (p1_hat - p2_hat) / error_estandar
# Valor-p
p_value <- switch(alternativa,
"mayor" = pnorm(z, lower.tail = FALSE),
"menor" = pnorm(z, lower.tail = TRUE),
"bilateral" = 2 * pnorm(-abs(z)))
# 🔹 Resultados por cada alpha
resultados <- lapply(alphas, function(alpha) {
z_crit <- qnorm(1 - alpha / 2)
error_indep <- sqrt((p1_hat * (1 - p1_hat)) / n1 +
(p2_hat * (1 - p2_hat)) / n2)
IC <- c((p1_hat - p2_hat) - z_crit * error_indep,
(p1_hat - p2_hat) + z_crit * error_indep)
list(
alpha = alpha,
proporcion_1 = p1_hat,
proporcion_2 = p2_hat,
diferencia_observada = p1_hat - p2_hat,
estadistico_z = z,
p_value = p_value,
intervalo_confianza = IC,
decision = ifelse(p_value < alpha, "Rechazar H0", "No Rechazar H0")
)
})
if (graficar) {
par(mfrow = c(ceiling(length(alphas)/2), 2))  # varias gráficas
for (alpha in alphas) {
z_crit <- qnorm(1 - alpha / 2)
curve(dnorm(x), from = -4, to = 4, lwd = 2, col = "gray30",
ylab = "Densidad", xlab = "Z",
main = paste("Alpha =", alpha))
abline(v = z, col = "blue", lwd = 2, lty = 2)
if (alternativa == "bilateral") {
abline(v = c(-z_crit, z_crit), col = "red", lty = 3)
} else if (alternativa == "mayor") {
abline(v = qnorm(1 - alpha), col = "red", lty = 3)
} else if (alternativa == "menor") {
abline(v = qnorm(alpha), col = "red", lty = 3)
}
legend("topright",
legend = c(paste("Z =", round(z, 3)),
paste("±Zcrit =", round(z_crit, 3))),
col = c("blue", "red"),
lty = c(2, 3),
bty = "n")
}
par(mfrow = c(1,1))  # reset
}
return(resultados)
}
#Evaluamos
resultado <- mi_prop_test_2vectores_binarios(
edu_mayo,
edu_julio,
alphas = c(0.030, 0.070, 0.025, 0.045, 0.001)
)
resultado
